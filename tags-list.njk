---
permalink: /tags/
layout: layouts/home.njk
pageCss: /css/archive.css
title: Topics
---
<div class="archive-main">
  <p class="page-kicker">Find a thread</p>
  <h1 class="archive-title">Topics</h1>
  <div class="subject-grid">
    {% for tag in collections.tagList %}
      <a href="{{ ('/tags/' + tag + '/') | url }}" class="subject-pill"><span>{{ tag }}</span><span class="mono subject-count">{{ collections[tag].length }}</span></a>
    {% endfor %}
  </div>
  <p class="archive-links"><a href="{{ '/posts/' | url }}">All writing</a></p>
</div>
