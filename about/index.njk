<script>
  (function () {
    var btn = document.querySelector("[data-copy-email]");
    if (!btn) return;
    var status = document.querySelector(".email-copy-status");
    var resetTimer;
    function showFallback(email) {
      status.hidden = false;
      status.replaceChildren();
      status.appendChild(document.createTextNode("Copy unavailable. Select the address: "));
      var address = document.createElement("a");
      address.href = "mailto:" + email;
      address.textContent = email;
      status.appendChild(address);
      var selection = window.getSelection();
      if (selection) {
        var range = document.createRange();
        range.selectNodeContents(address);
        selection.removeAllRanges();
        selection.addRange(range);
      }
    }
    btn.addEventListener("click", function () {
      var email = btn.getAttribute("data-copy-email");
      clearTimeout(resetTimer);
      btn.textContent = email + " · Copy";
      status.hidden = true;
      status.textContent = "";
      if (!navigator.clipboard || !navigator.clipboard.writeText) {
        showFallback(email);
        return;
      }
      navigator.clipboard.writeText(email).then(function () {
        btn.textContent = "Copied " + email + " ✓";
        status.hidden = false;
        status.textContent = "Email copied to clipboard.";
        resetTimer = setTimeout(function () {
          btn.textContent = email + " · Copy";
          status.hidden = true;
        }, 2000);
      }).catch(function () {
        showFallback(email);
      });
    });
  })();
</script>
