---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - post
    - posts
    - tagList
  addAllPagesToCollections: true
layout: layouts/home.njk
pageCss: /css/archive.css
eleventyComputed:
  title: Tagged “{{ tag }}”
permalink: /tags/{{ tag }}/
---
{% set postslist = collections[tag] %}
<div class="archive-main">
  <p class="page-kicker">Writing about</p>
  <h1 class="archive-title">{{ tag }}</h1>
  {% include "postslist.njk" %}
  <p class="archive-links"><a href="{{ '/tags/' | url }}">All topics</a> · <a href="{{ '/posts/' | url }}">All writing</a></p>
</div>
