<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <script src="{{ '/js/theme.js' | url }}"></script>
    <title>{{ title or metadata.title }}</title>
    {% set articleMeta = [] %}
    {% if type == "article" and date %}
      {% set publishedDate = date | htmlDateString %}
      {% set publishedAttrs = {property: "article:published_time", content: publishedDate} %}
      {% set _ = articleMeta.push({tag: "meta", attrs: publishedAttrs}) %}
      {% for t in (tags | default([]) | reject("equalto", "all") | reject("equalto", "nav") | reject("equalto", "post") | reject("equalto", "posts")) %}
        {% set tagAttrs = {property: "article:tag", content: t} %}
        {% set _ = articleMeta.push({tag: "meta", attrs: tagAttrs}) %}
      {% endfor %}
    {% endif %}
    {% metagen
      title=title or metadata.title,
      desc=description or metadata.description,
      url=(page.url | url | absoluteUrl(metadata.url)),
      type=type or "website",
      site_name=metadata.title,
      img=("/img/og-share.png" | url | absoluteUrl(metadata.url)),
      img_alt=metadata.author.name,
      img_width="1200",
      img_height="630",
      twitter_card_type="summary_large_image",
      twitter_handle=metadata.twitter.username,
      name=metadata.author.name,
      custom=articleMeta
    %}  
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "{{ metadata.author.name }}",
      "url": "{{ metadata.url }}",
      "sameAs": [
        "https://twitter.com/itsashis4u",
        "https://www.linkedin.com/in/itsashis4u",
        "https://github.com/itsashis4u",
        "https://dev.to/itsashis4u",
        "https://hashnode.com/@itsashis4u",
        "https://medium.com/@itsashis4u"
      ],
      "jobTitle": "Principal Engineer",
      "worksFor": {
        "@type": "Organization",
        "name": "Apollo 24|7"
      },
      "homeLocation": {
        "@type": "Place",
        "name": "Bengaluru, India"
      }
    }
    </script>
    {% if type == "article" and date %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | dump | safe }},
      "description": {{ (description or metadata.description) | dump | safe }},
      "datePublished": "{{ date | htmlDateString }}",
      "author": {
        "@type": "Person",
        "name": {{ metadata.author.name | dump | safe }},
        "url": "{{ metadata.url }}"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ page.url | url | absoluteUrl(metadata.url) }}"
      },
      "image": "{{ '/img/og-share.png' | url | absoluteUrl(metadata.url) }}",
      "publisher": {
        "@type": "Person",
        "name": {{ metadata.author.name | dump | safe }}
      },
      "inLanguage": "en"
    }
    </script>
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="{{ '/css/index.css' | url }}">
    <link rel="stylesheet" href="{{ '/css/prism-base16-monokai.dark.css' | url }}">
    {% if pageCss %}
      {% for href in ([pageCss] if pageCss is string else pageCss) %}
      <link rel="stylesheet" href="{{ href | url }}">
      {% endfor %}
    {% endif %}
    <link rel="alternate" href="{{ metadata.feed.path | url }}" type="application/atom+xml" title="{{ metadata.title }}">
    <link rel="alternate" href="{{ metadata.jsonfeed.path | url }}" type="application/json" title="{{ metadata.title }}">
    <link rel="icon" href="/img/favicon.ico" sizes="any">
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/img/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/img/favicon-16x16.png" sizes="16x16" type="image/png">
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8PX2BCKKRN"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8PX2BCKKRN');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="masthead">
      <a href="{{ '/' | url }}" class="wordmark" aria-label="Ashish, home">ashish<span aria-hidden="true">.</span></a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a>
        <a href="{{ '/posts/' | url }}"{% if page.url == '/posts/' %} aria-current="page"{% elif type == 'article' or page.url.startsWith('/tags/') %} aria-current="location"{% endif %}>Writing</a>
        <a href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>

      </nav>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme" hidden>
          <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
        </button>
    </header>

    <main id="main-content"{% if templateClass %} class="{{ templateClass }}"{% endif %}>
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <span>&copy; 2026 Ashish Kumar Badtiya</span>
      <div class="footer-links">
        <a href="https://github.com/itsashis4u">GitHub</a>
        <a href="{{ metadata.feed.path | url }}">RSS</a>
      </div>
    </footer>


    <!-- Current page: {{ page.url | url }} -->
    <!-- Twitter universal website tag code -->
    <script>
      !function(e,t,n,s,u,a){e.twq||(s=e.twq=function(){s.exe?s.exe.apply(s,arguments):s.queue.push(arguments);
      },s.version='1.1',s.queue=[],u=t.createElement(n),u.async=!0,u.src='//static.ads-twitter.com/uwt.js',
      a=t.getElementsByTagName(n)[0],a.parentNode.insertBefore(s,a))}(window,document,'script');
      // Insert Twitter Pixel ID and Standard Event data below
      twq('init','o67tu');
      twq('track','PageView');
    </script>
    <!-- End Twitter universal website tag code -->
    {% if pageJs %}
      {% for src in ([pageJs] if pageJs is string else pageJs) %}
      <script defer src="{{ src | url }}"></script>
      {% endfor %}
    {% endif %}
  </body>
</html>
