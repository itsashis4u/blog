---
layout: layouts/base.njk
templateClass: tmpl-post
pageCss: /css/post.css
type: article
---
{%- set visibleTags = tags | reject("equalto", "all") | reject("equalto", "nav") | reject("equalto", "post") | reject("equalto", "posts") -%}
<article class="article">
  <header class="article-header">
    <a class="article-back" href="{{ '/posts/' | url }}">← All writing</a>
    <h1>{{ title }}</h1>
    {% if description %}<p class="article-lede">{{ description }}</p>{% endif %}
    <p class="article-meta"><time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time><span aria-hidden="true"> · </span>Ashish Kumar Badtiya</p>
  </header>
  <div class="post-body">{{ content | safe }}</div>
  {% if marginalia %}
  <aside class="article-notes" aria-label="Additional notes">
    {% if marginalia.shipsWith and marginalia.shipsWith.length %}<h2>Included</h2><ul>{% for item in marginalia.shipsWith %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
    {% if marginalia.note %}<p>{{ marginalia.note }}</p>{% endif %}
    {% if marginalia.requires and marginalia.requires.length %}<h2>Requirements</h2><ul>{% for req in marginalia.requires %}<li>{{ req }}</li>{% endfor %}</ul>{% endif %}
  </aside>
  {% endif %}
  <footer class="article-footer">
    {% for tag in visibleTags %}<a href="{{ ('/tags/' + tag + '/') | url }}" class="tag-pill">{{ tag }}</a>{% endfor %}
  </footer>
  {% set nextPost = collections.posts | getNextCollectionItem(page) %}
  {% set previousPost = collections.posts | getPreviousCollectionItem(page) %}
  {% if nextPost or previousPost %}
  <nav class="article-adjacent" aria-label="More writing">
    {% if previousPost %}<a href="{{ previousPost.url | url }}"><span>Previous</span>{{ previousPost.data.title }}</a>{% endif %}
    {% if nextPost %}<a href="{{ nextPost.url | url }}"><span>Next</span>{{ nextPost.data.title }}</a>{% endif %}
  </nav>
  {% endif %}
</article>
